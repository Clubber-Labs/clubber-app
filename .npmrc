# O layout isolado do pnpm coloca as dependências transitivas sob .pnpm/, e o
# Babel resolve presets/plugins a partir da RAIZ do projeto (é onde mora o
# babel.config.js). Sem estes hoists, `babel-preset-expo` e os plugins que ele
# referencia por string não existem na raiz e o Metro morre com
# "Cannot find module 'babel-preset-expo'".
#
# Passa despercebido no dia a dia: com o cache de transform do Metro quente o
# Babel nem roda. Só aparece em bundle de cache frio — ou seja, exatamente no
# build do EAS. Ver docs/eas-update.md.
public-hoist-pattern[]=*babel*
public-hoist-pattern[]=@babel/*

# Defaults do pnpm, preservados porque declarar public-hoist-pattern substitui a
# lista inteira em vez de somar.
public-hoist-pattern[]=*eslint*
public-hoist-pattern[]=*prettier*
